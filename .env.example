# Postgres connection string. For local dev with the included docker-compose.yml:
DATABASE_URL="postgresql://ardit:ardit@localhost:5432/ardit"
# On a serverless host (Vercel) with Neon, DATABASE_URL should be Neon's pooled
# (PgBouncer) connection string, and DIRECT_URL its direct one (used by Prisma
# Migrate, which needs a non-pooled connection). Neon's dashboard gives you both.
DIRECT_URL="postgresql://ardit:ardit@localhost:5432/ardit"

# Auth.js — session signing secret. Generate a random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Resend (https://resend.com) - transactional email for training/game notifications.
# Leave RESEND_API_KEY empty in dev to log emails to the console instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="Coach Notifications <onboarding@resend.dev>"

# Comma-separated list of email addresses allowed to register as the Coach.
COACH_EMAILS="you@example.com"

# Set to "true" to take the whole site offline behind a maintenance page.
MAINTENANCE_MODE="false"
